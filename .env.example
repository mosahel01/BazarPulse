# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Database
SQLITE_DATABASE_PATH=./data/marketpulse.db

# Authentication (generate a strong random value, e.g. `openssl rand -hex 32`)
AUTH_SECRET=replace-me-with-a-long-random-secret

# Google Sign-In (optional). Public OAuth client ID for your Google Cloud project.
# When empty, the Google sign-in option is disabled on the frontend.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com